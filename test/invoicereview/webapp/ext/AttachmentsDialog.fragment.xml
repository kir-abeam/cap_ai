<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m">
  <Dialog
    title="Attachments"
    contentWidth="32rem">
    <content>
      <List
        items="{att>/items}"
        noDataText="No attachments for this invoice.">
        <StandardListItem
          title="{att>fileName}"
          description="{att>mediaType}"
          icon="sap-icon://pdf-attachment"
          type="Active"
          press=".onOpenAttachment" />
      </List>
    </content>
    <beginButton>
      <Button text="Close" press=".onCloseAttachments" />
    </beginButton>
  </Dialog>
</core:FragmentDefinition>
