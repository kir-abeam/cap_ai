{
  "_version": "1.86.0",
  "sap.app": {
    "id": "documentprocessing",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "82cd7df2-bcb8-42f4-88da-f6ff22186849"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zapi_doc_ex_header_o4/srvd_a2x/sap/zui_invoice_review_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "localAnnotations"
          ],
          "odataVersion": "4.0"
        }
      },
      "localAnnotations": {
        "uri": "annotations/annotations.xml",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "annotations/annotations.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "documentprocessing.ext.InvoiceEditLock"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "documentprocessing.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EmailsList",
          "target": "EmailsList"
        },
        {
          "pattern": "Email({key}):?query:",
          "name": "EmailsObjectPage",
          "target": "EmailsObjectPage"
        },
        {
          "pattern": "Email({key})/_Invoice({invoicesKey}):?query:",
          "name": "InvoiceObjectPage",
          "target": "InvoiceObjectPage"
        }
      ],
      "targets": {
        "EmailsList": {
          "type": "Component",
          "id": "EmailsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Email",
              "variantManagement": "Page",
              "navigation": {
                "Email": {
                  "detail": {
                    "route": "EmailsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EmailsObjectPage": {
          "type": "Component",
          "id": "EmailsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Email",
              "navigation": {
                "_Invoice": {
                  "detail": {
                    "route": "InvoiceObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_Invoice/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "EmailBody": {
                      "template": "documentprocessing.ext.EmailBody",
                      "position": {
                        "placement": "Before",
                        "anchor": "InvoicesFacet"
                      },
                      "title": "Email"
                    },
                    "AISummary": {
                      "template": "documentprocessing.ext.AISummary",
                      "position": {
                        "placement": "Before",
                        "anchor": "EmailBody"
                      },
                      "title": "AI Summary"
                    }
                  }
                }
              },
              "sectionLayout": "Tabs"
            }
          }
        },
        "InvoiceObjectPage": {
          "type": "Component",
          "id": "InvoiceObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Email/_Invoice",
              "controlConfiguration": {
                "_Item/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "Verify": {
                      "press": "documentprocessing.ext.VerificationHandler.onVerify",
                      "visible": "{= %{VerificationStatus} === 'P'}",
                      "enabled": "{= %{VerificationStatus} === 'P'}",
                      "text": "Verify"
                    },
                    "Reject": {
                      "press": "documentprocessing.ext.VerificationHandler.onReject",
                      "visible": "{= %{VerificationStatus} === 'P'}",
                      "enabled": "{= %{VerificationStatus} === 'P'}",
                      "text": "Reject"
                    },
                    "ShowAttachments": {
                      "press": "documentprocessing.ext.AttachmentsHandler.onShowAttachments",
                      "visible": true,
                      "enabled": true,
                      "text": "Attachments"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
