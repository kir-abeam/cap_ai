### Verify what was created (local target)
GET http://localhost:4004/invoice-review/Email?$expand=_Invoice($expand=_Item,_Attachment)

### ---------------------------------------------------------------------------
### Individual stages, for debugging the pipeline one step at a time.
### ---------------------------------------------------------------------------

### Summarize email — uses srv/Invoice.pdf as fallback
POST {{baseUrl}}/summarizeEmail
Content-Type: application/json

{
    "email": {
        "subject": "Invoices for Legal",
        "content": ""
    }
}

### Get invoice pages — uses srv/Invoice.pdf as fallback
POST {{baseUrl}}/getInvoicePages
Content-Type: application/json

{}

### Extract invoice data — uses srv/Invoice_3.pdf as fallback
POST {{baseUrl}}/extractInvoice
Content-Type: application/json

{}

### Classify a document — which prompt set processEmail will route it to.
### Returns { documentType: 'invoice' | 'payment_memo', confidence, reason }.
### No fallback: paste a base64 PDF.
POST {{baseUrl}}/classifyDocument
Content-Type: application/json

{
    "fileContent": "<base64 PDF>"
}

### Payment memo — page ranges. A covering memo plus all its appendix pages
### is ONE range. No fallback: paste a base64 PDF.
POST {{baseUrl}}/getMemoPages
Content-Type: application/json

{
    "fileContent": "<base64 PDF>"
}

### Payment memo — one invoice per appendix table row.
### No fallback: paste a base64 PDF.
POST {{baseUrl}}/extractMemoInvoices
Content-Type: application/json

{
    "memoContent": "<base64 PDF>",
    "emailContent": "<p>Please process the attached payment memo.</p>"
}
