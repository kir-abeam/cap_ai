{
  "name": "ai_cap",
  "version": "1.0.0",
  "dependencies": {
    "@sap-ai-sdk/langchain": "^2.10.0",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "hybrid": "cds watch --profile hybrid",
    "s4": "cds watch --profile s4",
    "watch-documentprocessing": "cds watch --open documentprocessing/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "ZUI_INVOICE_REVIEW_O4": {
        "kind": "odata",
        "model": "srv/external/ZUI_INVOICE_REVIEW_O4",
        "csrf": true,
        "csrfInBatch": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/documentprocessing"
  ]
}
